<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for API calls to local server -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera for QR pairing -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- PHASE 12 Kiosk Mode: required to become Device Owner and use Lock Task -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <!-- V2.3 / V18: FCM push notifications.
         POST_NOTIFICATIONS is required at runtime on Android 13+ (Tiramisu).
         The UI layer prompts the user once after first launch and the result
         is persisted; if denied, pushes still arrive but are dropped silently
         at the system level. WAKE_LOCK is requested by firebase-messaging for
         message processing during Doze. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RestaurantStaffApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_compat"
        android:roundIcon="@drawable/ic_launcher_compat"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RestaurantStaff"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection"
            android:theme="@style/Theme.RestaurantStaff">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Phase F — Static shortcut metadata pointing at the
                 notifications screen. Long-press the launcher icon to see
                 "Mở thông báo". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            PHASE 12 Kiosk Mode: receiver that allows the app to be promoted to
            Device Owner via `adb shell dpm set-device-owner <pkg>/.kiosk.RestaurantAdminReceiver`.
            Once promoted, Lock Task can be used to lock the device into this app.
        -->
        <receiver
            android:name=".kiosk.RestaurantAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            tools:ignore="ExportedReceiver">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            V2.3 / V18: FirebaseMessagingService. The FCM SDK finds this class
            via the manifest entry and routes incoming data/notification pushes
            here. We declare it without an exported flag because it must only be
            invoked by the system.
        -->
        <service
            android:name=".fcm.RestaurantFcmService"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            V2.3 / V18: BroadcastReceiver for "Accept" / "Decline" action taps
            on a push. exported=false because no other app should fire this;
            the system fires it from the PendingIntent we built on the
            notification itself.
        -->
        <receiver
            android:name=".fcm.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.restaurant.staff.fcm.ACTION_RESPOND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>